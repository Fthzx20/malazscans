datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// ============================================================
// AUTH & USERS (NEON POSTGRESQL)
// ============================================================
model User {
  id          String    @id @default(uuid())
  username    String    @unique
  email       String    @unique
  role        String    @default("user") // "admin" | "moderator" | "editor" | "translator" | "user"
  status      String    @default("active") // "active" | "suspended" | "banned"
  avatar      String?
  password    String?
  provider    String?   // "google" | "github" | null
  coins       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  bookmarks      Bookmark[]
  readingHistory ReadingHistory[]
  comments       Comment[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// CONTENT — novels, volumes, chapters
// ============================================================
model Novel {
  id               String         @id // slug-based ID (e.g. "red-sunset")
  title            String
  alternativeTitle String         @default("")
  originalTitle    String         @default("")
  japaneseTitle    String         @default("")
  romajiTitle      String         @default("")
  author           String
  illustrator      String         @default("")
  translator       String         @default("")
  publisher        String         @default("")
  synopsis         String         @default("")
  status           String         @default("ONGOING") // "ONGOING" | "COMPLETED" | "HIATUS"
  releaseSchedule  String         @default("")
  addedDate        DateTime       @default(now())
  rating           Float          @default(0)
  ratingCount      Int            @default(0)
  views            Int            @default(0)
  genres           String[]
  tags             String[]
  coverImage       String?        // URL to R2 or external
  isRecommended    Boolean        @default(false)
  volumes          Volume[]
  recommendations  Recommendation[]

  @@index([status])
  @@index([addedDate])
}

model Volume {
  id           String    @id @default(uuid())
  volumeNumber Int
  title        String
  novelId      String
  novel        Novel     @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters     Chapter[]

  @@index([novelId])
}

model Chapter {
  id            String         @id // e.g. "rs-v1-c1"
  title         String
  publishDate   DateTime       @default(now())
  content       String         // Tiptap JSON or legacy text
  isLocked      Boolean        @default(false)
  coinPrice     Int            @default(5)
  volumeId      String
  volume        Volume         @relation(fields: [volumeId], references: [id], onDelete: Cascade)
  illustrations Illustration[]

  @@index([volumeId])
  @@index([publishDate])
}

// ============================================================
// MEDIA
// ============================================================
model Illustration {
  id        String  @id @default(uuid())
  url       String  // URL to R2
  width     Int
  height    Int
  alt       String  @default("")
  chapterId String
  chapter   Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([chapterId])
}

// ============================================================
// ENGAGEMENT — comments, reactions, mentions
// ============================================================
// ============================================================
// ENGAGEMENT — comments, reactions, mentions
// Decoupled: chapterId is a string reference without @relation
// ============================================================
model Comment {
  id               Int       @id @default(autoincrement())
  parentId         Int?
  parent           Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies          Comment[] @relation("CommentReplies")
  chapterId        String
  userId           String?
  user             User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  username         String    // denormalized for display (guest or registered)
  text             String
  date             DateTime  @default(now())
  isUserRegistered Boolean   @default(false)
  reactions        Reaction[]
  mentions         Mention[]
  commentMentions  CommentMention[]

  @@index([chapterId])
  @@index([parentId])
  @@index([userId])
}

model Reaction {
  id        String  @id @default(uuid())
  type      String  // "like" | "heart"
  username  String
  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([type, username, commentId]) // prevent duplicate reactions
  @@index([commentId])
}

model Mention {
  id        String  @id @default(uuid())
  username  String
  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([commentId])
}

// ============================================================
// CURATION — recommendations, announcements
// ============================================================
model Recommendation {
  id         String   @id @default(uuid())
  novelId    String
  novel      Novel    @relation(fields: [novelId], references: [id], onDelete: Cascade)
  order      Int
  isPinned   Boolean  @default(false)
  isFeatured Boolean  @default(false)
  addedDate  DateTime @default(now())

  @@index([novelId])
  @@index([order])
}

model Announcement {
  id                  String   @id @default(uuid())
  title               String
  content             String
  priority            String   @default("normal") // "low" | "normal" | "high"
  startDate           DateTime
  endDate             DateTime
  autoDismissDuration Int      @default(10)
  status              String   @default("draft") // "published" | "draft"
  displayMode         String   @default("modal") // "modal" | "banner"
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([status, startDate, endDate])
}

// ============================================================
// USER DATA — bookmarks, reading history (Decoupled from Content)
// ============================================================
model Bookmark {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId String

  @@unique([userId, novelId])
  @@index([userId])
  @@index([novelId])
}

model ReadingHistory {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  novelId      String
  chapterId    String
  chapterTitle String
  timestamp    DateTime @default(now())

  @@index([userId, timestamp])
  @@index([userId, novelId])
}

// ============================================================
// SUPPLEMENTARY CONTENT
// ============================================================
model TranslatorNote {
  id        String @id @default(uuid())
  content   String
  chapterId String

  @@index([chapterId])
}

model AuthorNote {
  id        String @id @default(uuid())
  content   String
  chapterId String

  @@index([chapterId])
}

// ============================================================
// RATINGS (Decoupled from Content)
// ============================================================
model NovelRating {
  id        String   @id @default(uuid())
  novelId   String
  rating    Int      // 1 to 5 stars
  userId    String?  // null if guest
  username  String?  // name of user
  createdAt DateTime @default(now())

  @@unique([novelId, userId]) // registered users can rate once per novel
  @@index([novelId])
}

// ============================================================
// COMMENT MENTIONS (Decoupled from Content)
// ============================================================
model CommentMention {
  id        String   @id @default(uuid())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  novelId   String
  createdAt DateTime @default(now())

  @@index([commentId])
  @@index([novelId])
}



// ============================================================
// LINK PREVIEW CACHE
// ============================================================
model LinkPreviewCache {
  id          String   @id @default(uuid())
  url         String   @unique
  title       String?
  description String?
  image       String?
  favicon     String?
  siteName    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([url])
}

// ============================================================
// COIN & MONETIZATION (DECOUPLED DUAL-DB READY: TURSO + NEON)
// Note: Novel/Chapter references use decoupled string IDs
// ============================================================
model CoinOrder {
  id          String   @id @default(uuid())
  userId      String?
  packageId   String
  coins       Int
  amountIdr   Int
  status      String   @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "EXPIRED"
  snapToken   String?
  paymentType String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model CoinTransaction {
  id          String   @id @default(uuid())
  userId      String?
  type        String   // "TOPUP" | "UNLOCK"
  amount      Int      // positive for topup, negative for unlock
  description String
  chapterId   String?  // Decoupled string ID
  novelId     String?  // Decoupled string ID
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model UnlockedChapter {
  id         String   @id @default(uuid())
  userId     String
  novelId    String   // Decoupled string ID
  chapterId  String   // Decoupled string ID
  cost       Int      @default(5)
  unlockedAt DateTime @default(now())

  @@unique([userId, chapterId])
  @@index([userId])
  @@index([chapterId])
}
