# ============================================================
# MALAZ SCANS — ENVIRONMENT CONFIGURATION
# ============================================================

# 1. NEON POSTGRESQL (Users, Coins, Auth, Comments)
# Dapatkan dari: https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. TURSO LIBSQL (Novel Content, Volumes, Chapters)
# Dapatkan dari: https://turso.tech
TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# 3. AUTHENTICATION & SECURITY (Native OAuth 2.0)
# Session secret key for HMAC-SHA256 cookie signing (Generate: openssl rand -hex 32)
SESSION_SECRET="generate-a-secure-random-string-at-least-32-chars-long"

# Google OAuth 2.0 (Gratis dari Google Cloud Console: https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth App (Gratis dari GitHub Developer Settings: https://github.com/settings/developers)
# Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Next.js App Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin configuration (Server-only email verification)
ADMIN_EMAIL="admin@malazscans.com"
NEXT_PUBLIC_ADMIN_EMAIL="admin@malazscans.com"

# 4. CLOUDFLARE R2 (Image Storage - Covers & Illustrations)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL="https://pub-8df6d927fbb343468b08e5f0f8498440.r2.dev"
